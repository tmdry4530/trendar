PORT=4000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=trendar

# GitHub OAuth App (dev/prod 각각 별도 앱 등록 — 콜백 URL이 1개뿐)
# dev 콜백: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 인증/세션
# TOKEN_ENCRYPTION_KEY: 64자 hex(32바이트). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
APP_URL=http://localhost:5173
SESSION_TTL_DAYS=30

# Paddle Billing — API 키·가격 ID·공개 client token이 모두 있어야 결제 활성화
PADDLE_ENV=sandbox           # sandbox 또는 production (API 키·client token 환경과 일치)
PADDLE_API_KEY=              # 서버 전용 비밀 키
PADDLE_PRICE_ID_PRO=
PADDLE_CLIENT_TOKEN=         # Paddle.js용 공개 client-side token (서버가 클라이언트에 전달)
PADDLE_WEBHOOK_SECRET=       # 서버 전용 웹훅 서명 secret
# Paddle dashboard → Checkout settings → Default payment link:
# https://trendar.org/account/billing (approved domain)으로 설정해야 거래 생성이 성공한다.

# 첫 방문 국가 단위 언어 선택 (Cloudflare cf-ipcountry, 없으면 브라우저 언어 사용)

# 사용자당 watch query 최대 개수
MAX_QUERIES_PER_USER=10

# ETL
ETL_CRON=0 */6 * * *
ETL_PER_QUERY=100            # 검색어당 수집 깊이(스타 상위 N). 상한 100(Search per_page 한계)
ETL_MIN_STARS=1000           # base 슬라이스 스타 하한(>=). 0 = 제한 없음

# 신생 트렌드 슬라이스 (조건마다 created:>윈도우 검색을 병행 수집)
ETL_TREND_WINDOW_DAYS=90     # 수집 창 — created:>N일 레포까지 수집(넓게 추적)
ETL_TREND_MIN_STARS=50       # 신생 슬라이스 전용 스타 하한 (base 하한과 별도)
ETL_FRESH_WINDOW_DAYS=7      # 초신생 슬라이스 창 — created:>N일. trend 슬라이스(스타 상위 100) 커트라인에 가려진 갓 생긴 레포를 일찍 잡는다
ETL_FRESH_MIN_STARS=20       # 초신생 슬라이스 전용 스타 하한
RISING_WINDOW_DAYS=15        # 신생 급상승 '노출' 창 — 생성 N일 이내만 표시 (대시보드·공개 피드 공통)

# 수동 수집 일일 한도 (KST 자정 리셋)
MAX_MANUAL_ETL_PER_DAY=10

# 공개 트렌드 (로그인 없는 /trending · /repo · /og · /badge · /sitemap.xml)
# 서버 전용 fine-grained PAT — Repository access: Public repositories (read-only), 추가 권한 없음. 비우면 공개 수집을 건너뛴다
PUBLIC_GITHUB_TOKEN=
# 수집할 피드 slug(쉼표 구분). 비우면 전체 카탈로그(언어 8 · 주제 24). 모르는 slug는 기동 오류
PUBLIC_LANGUAGES=
PUBLIC_TOPICS=
ETL_SEARCH_INTERVAL_MS=2100  # Search API 호출 시작 간격(ms). 2100 미만 값은 2100으로 올림(30회/분 한도 보호)

# 급상승 랭킹 (rising-score-v3 규칙 — 공개 피드·대시보드 신생 급상승 공통)
RISING_MIN_RATE=100          # 하루 환산 증가(rate_24h) 하한
RISING_MIN_GROWTH=0.10       # 24h 증가율 하한 — 이것 또는 RISING_ABS_PASS 또는 생성 기준선이어야 노출
RISING_ABS_PASS=500          # 증가율과 무관하게 노출하는 rate_24h

# 공개 경로 남용 방지 · 집계
PUBLIC_IMAGE_RATE_LIMIT_PER_MIN=120  # OG 이미지 + 배지 합산 IP당 분당 요청 상한
PUBLIC_ANALYTICS_FLUSH_MS=60000      # 페이지뷰 메모리 집계를 DB에 쓰는 주기(ms)
TRUST_PROXY_HOPS=1                   # 앞단 프록시 수(VPS Traefik 1). Cloudflare 프록시를 켜면 2
